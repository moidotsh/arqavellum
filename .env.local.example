# Arqavellum environment variables.
# Copy this file to `.env.local` and fill in the values for your
# Supabase project. Arqavellum needs URL + anon key — that's it. Consumers
# add domain-specific env vars as needed.
#
# Find these in your Supabase dashboard:
#   Project Settings → API → Project URL
#   Project Settings → API → Project API keys → anon public

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Web analytics (opt-in, invariant 13): set to 1 to inject the Vercel
# Web Analytics script on production web builds. Also enable Web
# Analytics in the Vercel dashboard and redeploy — until both, the
# script 404s (harmless). Unset = the seam stays dormant (classification
# still runs locally; nothing leaves the device).
# EXPO_PUBLIC_WEB_ANALYTICS=1

# Dev-mode auth bypass: set to 1 to skip the login flow entirely and
# explore the shell without a Supabase project — a mock session
# (dev-user) makes AuthGuard read 'authenticated'. Day-0 friendly:
# unset it once your Supabase project exists.
# EXPO_PUBLIC_DISABLE_AUTH=1

# Print-kit QR poster generator (scripts/generate-print-kit.ts, invariant
# 13): the URL encoded into the printed QR codes, e.g.
# https://your-domain.example/qr — 17 bytes max (QR version 1-L). The
# tool refuses to run without it.
# PRINT_QR_URL=https://your-domain.example/qr
